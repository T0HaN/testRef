@app.get("/chars", response_class=HTMLResponse)
async def player_chars(
        request: Request,
        current_user: dict = Depends(require_player)
):
    """Список персонажей игрока"""
    chars = load_chars(current_user['username'])

    # Нормализуем каждого персонажа для безопасного доступа к полям
    normalized_chars = []
    for char in chars:
        c = normalize_char(char)
        # Добавляем вычисленные поля для отображения
        c['_ac_calculated'] = calculate_ac(c)
        normalized_chars.append(c)

    return templates.TemplateResponse("CharList1.html", context={
        "request": request,
        "chars": normalized_chars,
        "username": current_user['username'],
        "role": current_user.get('role', 'player'),
        "error": None,
        "success": None,
        "info": None
    })


@app.get("/player/join", response_class=HTMLResponse)
async def player_join_page(
        request: Request,
        code: Optional[str] = None,
        char_id: Optional[int] = None,
        current_user: dict = Depends(require_player)
):
    """Страница подключения к комнате"""
    chars = load_chars(current_user['username'])

    # Загружаем профиль игрока с историей комнат
    profile = load_user_profile(current_user['username'])
    joined_room_ids = profile.get('joined_rooms', [])

    # Получаем данные о сохранённых комнатах
    rooms_data = load_rooms()
    my_rooms = []
    for room_id in joined_room_ids:
        room = next((r for r in rooms_data['rooms'] if r['id'] == room_id), None)
        if room:
            my_rooms.append({
                'id': room['id'],
                'name': room['name'],
                'invite_code': room['invite_code'],
                'active': room.get('active', True),
                'master_id': room.get('master_id', ''),
                'current_players': len(room.get('current_players', [])),
                'max_players': room.get('max_players', 6)
            })

    # Если передан char_id — предзаполняем
    preselected_char = None
    if char_id:
        preselected_char = next((c for c in chars if c['id'] == char_id), None)
        if preselected_char:
            preselected_char = normalize_char(preselected_char)

    return templates.TemplateResponse("player_join.html", context={
        "request": request,
        "chars": [normalize_char(c) for c in chars],
        "preselected_char": preselected_char,
        "code": code or '',
        "my_rooms": my_rooms,  # ← список сохранённых комнат
        "username": current_user['username'],
        "error": None,
        "success": None
    })


@app.post("/player/join")
async def player_join(
        request: Request,
        code: str = Form(...),
        char_id: int = Form(...),
        current_user: dict = Depends(require_player)
):
    """Подключение игрока к комнате по коду"""
    code = code.strip().upper()
    chars = load_chars(current_user['username'])
    char = next((c for c in chars if c['id'] == char_id), None)

    if not char:
        return templates.TemplateResponse("player_join.html", context={
            "request": request,
            "chars": [normalize_char(c) for c in chars],
            "preselected_char": None,
            "code": code,
            "my_rooms": [],
            "username": current_user['username'],
            "error": "Персонаж не найден",
            "success": None
        })

    rooms_data = load_rooms()
    room = next((r for r in rooms_data['rooms'] if r['invite_code'] == code), None)

    if not room:
        return templates.TemplateResponse("player_join.html", context={
            "request": request,
            "chars": [normalize_char(c) for c in chars],
            "preselected_char": None,
            "code": code,
            "my_rooms": [],
            "username": current_user['username'],
            "error": "Комната с таким кодом не найдена",
            "success": None
        })

    if not room.get('active', True):
        return templates.TemplateResponse("player_join.html", context={
            "request": request,
            "chars": [normalize_char(c) for c in chars],
            "preselected_char": None,
            "code": code,
            "my_rooms": [],
            "username": current_user['username'],
            "error": "Комната закрыта",
            "success": None
        })

    # Проверяем, не подключён ли уже
    for p in room.get('current_players', []):
        if p.get('username') == current_user['username']:
            return RedirectResponse(url=f"/player/room/{room['id']}", status_code=303)

    if len(room.get('current_players', [])) >= room.get('max_players', 6):
        return templates.TemplateResponse("player_join.html", context={
            "request": request,
            "chars": [normalize_char(c) for c in chars],
            "preselected_char": None,
            "code": code,
            "my_rooms": [],
            "username": current_user['username'],
            "error": "Комната заполнена",
            "success": None
        })

    # Подключаем игрока
    # Подключаем игрока
    room.setdefault('current_players', []).append({
        'username': current_user['username'],
        'char_id': char_id,
        'char_name': char['name'],
        'joined_at': datetime.now().isoformat(),
        'last_active': time.time()  # 🔥 ВАЖНО: начальное время активности
    })
    save_rooms(rooms_data)

    #  Сохраняем комнату в историю игрока
    add_room_to_player_history(current_user['username'], room['id'])

    return RedirectResponse(url=f"/player/room/{room['id']}", status_code=303)


@app.get("/player/join/{room_id}")
async def quick_join(
        room_id: str,
        request: Request,
        current_user: dict = Depends(require_player)
):
    """Быстрое подключение к сохранённой комнате"""
    rooms_data = load_rooms()
    room = next((r for r in rooms_data['rooms'] if r['id'] == room_id), None)

    if not room:
        return RedirectResponse(url="/player/join", status_code=303)

    if not room.get('active', True):
        return RedirectResponse(url="/player/join?error=room_closed", status_code=303)

    # Проверяем, есть ли у игрока персонажи
    chars = load_chars(current_user['username'])
    if not chars:
        return RedirectResponse(url="/chars", status_code=303)

    # Если игрок уже подключён — редирект в комнату
    for p in room.get('current_players', []):
        if p.get('username') == current_user['username']:
            return RedirectResponse(url=f"/player/room/{room_id}", status_code=303)

    if len(room.get('current_players', [])) >= room.get('max_players', 6):
        return RedirectResponse(url="/player/join?error=room_full", status_code=303)

    # Берём первого персонажа (или можно показать выбор)
    char = chars[0]

    # Подключаем
    room.setdefault('current_players', []).append({
        'username': current_user['username'],
        'char_id': char['id'],
        'char_name': char['name'],
        'joined_at': datetime.now().isoformat()
    })
    save_rooms(rooms_data)

    # Обновляем историю (на всякий случай)
    add_room_to_player_history(current_user['username'], room_id)

    return RedirectResponse(url=f"/player/room/{room_id}", status_code=303)


@app.get("/player/room/{room_id}", response_class=HTMLResponse)
async def player_room(
        room_id: str,
        request: Request,
        current_user: dict = Depends(require_player)
):
    """Страница комнаты для игрока"""
    rooms_data = load_rooms()
    room = next((r for r in rooms_data['rooms'] if r['id'] == room_id), None)

    if not room:
        return RedirectResponse(url="/player/join", status_code=303)

    # Проверяем, что игрок подключён
    player_entry = next(
        (p for p in room.get('current_players', [])
         if p.get('username') == current_user['username']),
        None
    )

    if not player_entry:
        return RedirectResponse(url="/player/join?error=not_connected", status_code=303)

    # Загружаем персонажа
    chars = load_chars(current_user['username'])
    char = next((c for c in chars if c['id'] == player_entry.get('char_id')), None)
    if not char:
        return RedirectResponse(url="/player/join?error=no_char", status_code=303)

    char = normalize_char(char)

    # Подготавливаем данные для проверок
    saves, skills = prepare_skills_and_saves(char)

    # Проверяем, заклинатель ли персонаж
    char_class = char.get('char_class', '')
    is_spellcaster = char_class in ['Волшебник', 'Жрец', 'Бард', 'Колдун', 'Чародей', 'Друид', 'Паладин', 'Следопыт',
                                    'Изобретатель']

    # Загружаем известные заклинания
    known_spells = []
    if is_spellcaster:
        known_spells_names = char.get('inventory', {}).get('known_spells', [])
        _, known_spells, _ = get_spells_for_class(char_class, char.get('level', 1), known_spells_names)

    return templates.TemplateResponse("player_room.html", context={
        "request": request,
        "room": room,
        "char": char,
        "saves": saves,
        "skills": skills,
        "is_spellcaster": is_spellcaster,
        "known_spells": known_spells,
        "username": current_user['username'],
        "error": None,
        "success": None
    })


@app.get("/player/room/{room_id}/events")
async def player_room_events(
        room_id: str,
        request: Request,
        current_user: dict = Depends(require_player)
):
    """SSE для игроков (только броски)"""
    rooms_data = load_rooms()
    room = next((r for r in rooms_data['rooms'] if r['id'] == room_id), None)
    if not room:
        return StreamingResponse(iter([]), status_code=404)

    if not any(p['username'] == current_user['username'] for p in room.get('current_players', [])):
        return StreamingResponse(iter([]), status_code=403)

    queue = add_sse_listener(room_id)

    async def event_stream():
        try:
            while True:
                if queue:
                    event = queue.pop(0)
                    if event['event'] == 'roll_added':
                        yield f"event: {event['event']}\ndata: {json.dumps(event['data'], ensure_ascii=False)}\n\n"
                else:
                    await asyncio.sleep(0.5)
        finally:
            remove_sse_listener(room_id, queue)

    return StreamingResponse(
        event_stream(),
        media_type="text/event-stream",
        headers={"Cache-Control": "no-cache", "Connection": "keep-alive", "X-Accel-Buffering": "no"}
    )


@app.post("/player/room/ammo/use")
async def use_ammo(
        ammo: AmmoUseRequest,
        current_user: dict = Depends(require_player)
):
    room_id = current_user.get('current_room')
    if not room_id:
        raise HTTPException(status_code=400, detail="Not in room")

    rooms_data = load_rooms()
    room = next((r for r in rooms_data['rooms'] if r['id'] == room_id), None)
    if not room:
        raise HTTPException(status_code=404, detail="Room not found")

    player_entry = next(
        (p for p in room['current_players'] if p['username'] == current_user['username']),
        None
    )
    if not player_entry:
        raise HTTPException(status_code=404, detail="Player not found")

    user_chars = load_chars(current_user['username'])
    char = next((c for c in user_chars if c['id'] == player_entry['char_id']), None)
    if not char:
        raise HTTPException(status_code=404, detail="Character not found")

    char = normalize_char(char)
    ammo_list = char['inventory'].get(ammo.ammo_type, [])
    remaining = ammo.qty

    for item in ammo_list:
        if remaining <= 0:
            break
        if item.get('qty', 0) > 0:
            use_amount = min(remaining, item['qty'])
            item['qty'] -= use_amount
            remaining -= use_amount

    save_chars(current_user['username'], user_chars)
    return {'status': 'ok', 'remaining': char['inventory'].get(ammo.ammo_type, [])}


@app.post("/room/{room_id}/roll/history")
async def save_roll_history(
        room_id: str,
        roll: RollRequest,
        request: Request,
        current_user: dict = Depends(get_current_user)
):
    rooms_data = load_rooms()
    room = next((r for r in rooms_data['rooms'] if r['id'] == room_id), None)
    if not room:
        raise HTTPException(status_code=404, detail="Room not found")

    is_master = (current_user.get('role') == 'master' and room['master_id'] == current_user['username'])
    is_player = any(p['username'] == current_user['username'] for p in room.get('current_players', []))

    if not (is_master or is_player):
        raise HTTPException(status_code=403, detail="Access denied")

    roll_entry = {
        'id': f"roll_{int(time.time() * 1000)}",
        'timestamp': time.time(),
        'player': current_user['username'],
        **roll.dict()
    }

    room.setdefault('roll_history', [])
    room['roll_history'].insert(0, roll_entry)
    room['roll_history'] = room['roll_history'][:100]
    save_rooms(rooms_data)

    broadcast_room_event(room_id, 'roll_added', roll_entry)
    return {'status': 'ok', 'roll': roll_entry}


@app.get("/player/room/leave")
async def leave_room(
        request: Request,
        current_user: dict = Depends(require_player)
):
    room_id = request.cookies.get('current_room')
    if room_id:
        rooms_data = load_rooms()
        for room in rooms_data['rooms']:
            if room['id'] == room_id:
                room['current_players'] = [
                    p for p in room.get('current_players', [])
                    if p['username'] != current_user['username']
                ]
                broadcast_room_event(room_id, 'player_left', {'username': current_user['username']})
                break
        save_rooms(rooms_data)

    response = RedirectResponse(url="/chars", status_code=303)
    response.delete_cookie("current_room")
    return response


@app.post("/player/heartbeat")
async def player_heartbeat(current_user: dict = Depends(require_player)):
    """Обновляет время последней активности игрока во всех комнатах, где он есть"""
    rooms_data = load_rooms()
    now = time.time()
    updated = False

    for room in rooms_data['rooms']:
        for p in room.get('current_players', []):
            if p['username'] == current_user['username']:
                p['last_active'] = now
                updated = True

    if updated:
        save_rooms(rooms_data)

    return {'status': 'ok'}


# === Character routes ===
@app.get("/char/{char_id}", response_class=HTMLResponse)
async def view_char(
        char_id: int,
        request: Request,
        current_user: dict = Depends(require_player)
):
    chars = load_chars(current_user['username'])
    char = next((c for c in chars if c['id'] == char_id), None)
    if not char:
        return RedirectResponse(url="/chars", status_code=303)

    char = normalize_char(char)  # 🔥 Теперь автоматически пересчитает level и prof_bonus
    char['_calculated_ac'] = calculate_ac(char)

    saves, skills = prepare_skills_and_saves(char)
    features = get_class_features(char.get('char_class', ''), char.get('subclass', 'Нет'), char.get('level', 1))

    # 🔥 Прогресс опыта
    current_level = char.get('level', 1)
    current_xp = char.get('xp', 0)
    xp_progress = get_level_progress(current_xp, current_level)
    next_level_xp = XP_THRESHOLDS[current_level] if current_level < 20 else "MAX"

    return templates.TemplateResponse("character_view.html", context={
        "request": request,
        "char": char,
        "saves": saves,
        "skills": skills,
        "class_features": features,
        "back_url": "/chars",
        "back_text": "← Назад к списку",
        "current_user": current_user,
        "xp_progress": xp_progress,
        "next_level_xp": next_level_xp,
        "error": None,
        "success": None
    })


@app.post("/char/{char_id}/hp")
async def update_hp(
        char_id: int,
        username: str = Form(...),
        current_hp: int = Form(...),
        temp_hp: int = Form(0),
        current_user: dict = Depends(get_current_user)
):
    """Обновление текущего и временного здоровья персонажа"""
    # Проверка прав: игрок может менять только своего персонажа
    if current_user['role'] == 'player' and current_user['username'] != username:
        raise HTTPException(status_code=403, detail="Нет прав на изменение этого персонажа")

    user_chars = load_chars(username)
    char = next((c for c in user_chars if c['id'] == char_id), None)
    if not char:
        raise HTTPException(status_code=404, detail="Персонаж не найден")

    # Обновляем значения (не даем уйти в минус)
    char.setdefault('hp', {'current': 10, 'max': 10, 'temp': 0})
    char['hp']['current'] = max(0, current_hp)
    char['hp']['temp'] = max(0, temp_hp)

    save_chars(username, user_chars)

    return {
        "status": "ok",
        "current_hp": char['hp']['current'],
        "temp_hp": char['hp']['temp'],
        "max_hp": char['hp']['max']
    }


