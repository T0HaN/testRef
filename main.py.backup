@app.post("/char/{char_id}/description")
async def save_description(
        char_id: int,
        request: Request,
        char_image: Optional[UploadFile] = File(None),
        remove_image: Optional[str] = Form(None),
        appearance: str = Form(""),
        background: str = Form(""),
        allies: str = Form(""),
        personality: str = Form(""),
        ideals: str = Form(""),
        bonds: str = Form(""),
        flaws: str = Form(""),
        current_user: dict = Depends(require_player)
):
    """Сохранение описания персонажа и изображения"""
    chars = load_chars(current_user['username'])
    char = next((c for c in chars if c['id'] == char_id), None)
    if not char:
        return RedirectResponse(url="/chars", status_code=303)

    # 🔥 Отладка: смотрим, что пришло
    print(f"🔍 Сохранение описания для char_id={char_id}")
    print(f"   appearance: '{appearance[:50]}...' if len(appearance) > 50 else appearance")
    print(f"   background: '{background[:50]}...' if len(background) > 50 else background")

    # НЕ вызываем normalize_char здесь, чтобы не затереть данные
    # char = normalize_char(char)  # ❌ Убери эту строку

    try:
        # Обработка текстовых полей
        char['description_appearance'] = appearance.strip()
        char['description_background'] = background.strip()
        char['description_allies'] = allies.strip()
        char['description_personality'] = personality.strip()
        char['description_ideals'] = ideals.strip()
        char['description_bonds'] = bonds.strip()
        char['description_flaws'] = flaws.strip()

        # 🔥 Отладка: проверяем, что записали
        print(f"   После записи: appearance='{char['description_appearance'][:50]}'")

        # Обработка изображения
        if remove_image == "1":
            char['description_image'] = None
        elif char_image and char_image.filename:
            content = await char_image.read()

            if len(content) > 5 * 1024 * 1024:
                return templates.TemplateResponse("char_description.html", context={
                    "request": request,
                    "char": char,
                    "error": "Файл слишком большой! Максимум 5MB.",
                    "success": None
                })

            if char_image.content_type not in ['image/jpeg', 'image/png', 'image/gif', 'image/webp']:
                return templates.TemplateResponse("char_description.html", context={
                    "request": request,
                    "char": char,
                    "error": "Неподдерживаемый формат изображения.",
                    "success": None
                })

            image_base64 = base64.b64encode(content).decode('utf-8')
            char['description_image'] = f"data:{char_image.content_type};base64,{image_base64}"
            print(f"   Изображение сохранено, размер: {len(char['description_image'])} символов")

        # 🔥 Отладка: проверяем перед сохранением
        print(f"   Перед save_chars: appearance='{char.get('description_appearance', 'NOT SET')}'")

        save_chars(current_user['username'], chars)

        # 🔥 Отладка: проверяем после сохранения
        chars_check = load_chars(current_user['username'])
        char_check = next((c for c in chars_check if c['id'] == char_id), None)
        if char_check:
            print(f"   После save_chars: appearance='{char_check.get('description_appearance', 'NOT SET')}'")

    except Exception as e:
        print(f"❌ Ошибка сохранения: {e}")
        import traceback
        traceback.print_exc()
        return templates.TemplateResponse("char_description.html", context={
            "request": request,
            "char": char,
            "error": f"Ошибка сохранения: {str(e)}",
            "success": None
        })

    return RedirectResponse(url=f"/char/{char_id}/description", status_code=303)


@app.get("/char/{char_id}/inventory", response_class=HTMLResponse)
async def view_inventory(
    char_id: int,
    request: Request,
    action: Optional[str] = None,
    idx: Optional[int] = None,
    current_user: dict = Depends(require_player)
):
    chars = load_chars(current_user['username'])
    char = next((c for c in chars if c['id'] == char_id), None)
    if not char:
        return RedirectResponse(url="/chars", status_code=303)

    char = normalize_char(char)
    char['_calculated_ac'] = calculate_ac(char)

    # Экипировка / снятие брони
    if action == 'equip_armor' and idx is not None:
        for i, a in enumerate(char['inventory']['armor']):
            a['equipped'] = (i == idx)
        save_chars(current_user['username'], chars)
    elif action == 'unequip_armor' and idx is not None:
        if 0 <= idx < len(char['inventory']['armor']):
            char['inventory']['armor'][idx]['equipped'] = False
            save_chars(current_user['username'], chars)

    # Безопасная структура каталога
    print(f"🔍 EQUIPMENT_DATA keys: {list(EQUIPMENT_DATA.keys())}")

    equip_catalog = {
        'weapons': EQUIPMENT_DATA.get('weapons', {}),
        'armor': EQUIPMENT_DATA.get('armor', {}),
        'gear': EQUIPMENT_DATA.get('gear', [])
    }

    return templates.TemplateResponse("inventory.html", context={
        "request": request,
        "char": char,
        "equipment": equip_catalog,
        "error": None,
        "success": None
    })


@app.post("/char/{char_id}/equipment/buy")
async def buy_equipment(
        char_id: int,
        request: Request,
        current_user: dict = Depends(require_player)
):
    form = await request.form()
    chars = load_chars(current_user['username'])
    char = next((c for c in chars if c['id'] == char_id), None)
    if not char:
        return RedirectResponse(url="/chars", status_code=303)

    char = normalize_char(char)
    item_name = form.get('item_name', '').strip()
    cost_str = form.get('cost', '0 зм')
    eq_type = form.get('eq_type', 'gear')

    if not item_name:
        return RedirectResponse(url=f"/char/{char_id}/inventory", status_code=303)

    try:
        if eq_type == 'weapon':
            # Ищем предмет в каталоге
            found_item = None
            weapon_category = ''
            for cat_name, items in EQUIPMENT_DATA.get('weapons', {}).items():
                for item in items:
                    if item.get('name') == item_name:
                        found_item = item
                        weapon_category = cat_name  # simple_melee, martial_ranged и т.д.
                        break
                if found_item:
                    break

            if found_item:
                from utils import parse_damage, map_weapon_type, determine_weapon_proficiency

                dmg = parse_damage(found_item.get('damage', '1d4'))
                w_type = map_weapon_type(found_item.get('properties', []))

                #  Автоматическое определение владения
                char_class = char.get('char_class', '')
                is_proficient = determine_weapon_proficiency(char_class, weapon_category, item_name)

                ammo_type = None
                if w_type == 'ammunition':
                    name_lower = item_name.lower()
                    if 'арбалет' in name_lower:
                        ammo_type = 'bolts'
                    elif 'лук' in name_lower or 'праща' in name_lower:
                        ammo_type = 'arrows'
                    else:
                        ammo_type = 'arrows'

                char['inventory']['weapons'].append({
                    'name': found_item['name'],
                    'type': w_type,
                    'damage': dmg,
                    'ammo_type': ammo_type,
                    'description': ', '.join(found_item.get('properties', [])),
                    'proficient': is_proficient,  # ✅ Авто-владение
                    'cost': found_item.get('cost'),
                    'weight': found_item.get('weight')
                })
            else:
                char['inventory']['weapons'].append({
                    'name': item_name,
                    'type': 'standard',
                    'damage': '1d4',
                    'description': '',
                    'proficient': True,  # Кастомное оружие — по умолчанию владеет
                    'cost': cost_str
                })

        elif eq_type == 'armor':
            # ... (без изменений)
            found_item = None
            for cat_name, items in EQUIPMENT_DATA.get('armor', {}).items():
                for item in items:
                    if item.get('name') == item_name:
                        found_item = item
                        break
                if found_item:
                    break

            if found_item:
                ac_raw = found_item.get('ac', '10')
                ac_clean = ac_raw.replace(' + модификатор Лов', '').replace('(макс. 2)', '').strip()
                if not ac_clean.isdigit():
                    ac_clean = '10'

                char['inventory']['armor'].append({
                    'name': found_item['name'],
                    'ac': ac_clean,
                    'stealth': found_item.get('stealth'),
                    'strength_req': found_item.get('strength_requirement'),
                    'equipped': False,
                    'cost': found_item.get('cost'),
                    'weight': found_item.get('weight')
                })
            else:
                char['inventory']['armor'].append({
                    'name': item_name,
                    'ac': '10',
                    'equipped': False,
                    'cost': cost_str
                })

        else:  # gear
            # ... (без изменений)
            name_lower = item_name.lower()
            if 'стрел' in name_lower or 'arrow' in name_lower:
                existing = next((a for a in char['inventory']['arrows'] if a['name'] == item_name), None)
                if existing:
                    existing['qty'] += 1
                else:
                    char['inventory']['arrows'].append({
                        'name': item_name,
                        'extra_dmg': 0,
                        'qty': 20
                    })
            elif 'болт' in name_lower or 'bolt' in name_lower:
                existing = next((b for b in char['inventory']['bolts'] if b['name'] == item_name), None)
                if existing:
                    existing['qty'] += 1
                else:
                    char['inventory']['bolts'].append({
                        'name': item_name,
                        'extra_dmg': 0,
                        'qty': 20
                    })
            else:
                existing = next((g for g in char['inventory']['gear'] if g['name'] == item_name), None)
                if existing:
                    existing['qty'] += 1
                else:
                    char['inventory']['gear'].append({
                        'name': item_name,
                        'cost': cost_str,
                        'qty': 1
                    })

        save_chars(current_user['username'], chars)

    except Exception as e:
        print(f"️ Ошибка покупки: {e}")

    return RedirectResponse(url=f"/char/{char_id}/inventory", status_code=303)


@app.get("/char/{char_id}/spells", response_class=HTMLResponse)
async def view_spells(
    char_id: int,
    request: Request,
    current_user: dict = Depends(require_player)
):
    chars = load_chars(current_user['username'])
    char = next((c for c in chars if c['id'] == char_id), None)
    if not char:
        return RedirectResponse(url="/chars", status_code=303)

    char = normalize_char(char)
    char_class = char.get('char_class', '')
    char_level = char.get('level', 1)

    known_spells_names = char.get('inventory', {}).get('known_spells', [])
    available_spells, known_spells, is_prepared_caster = get_spells_for_class(
        char_class, char_level, known_spells_names
    )

    # Лимит заклинаний
    max_spells = 0
    spells_limit_type = "prepared" if is_prepared_caster else "known"

    if not is_prepared_caster:
        if char_class in CLASSES_DATA:
            cls_data = CLASSES_DATA[char_class]
            for entry in cls_data.get('level_table', []):
                if entry.get('level', 0) <= char_level:
                    max_spells = max(max_spells, entry.get('spells_known', 0))
    else:
        spellcasting_ability = {
            'Жрец': 'WIS', 'Друид': 'WIS', 'Волшебник': 'INT',
            'Паладин': 'CHA', 'Изобретатель': 'INT', 'Следопыт': 'WIS'
        }.get(char_class, 'WIS')
        ability_mod = char['stats'][spellcasting_ability]['modifier']
        max_spells = ability_mod + char_level

    return templates.TemplateResponse("spells.html", context={
        "request": request,
        "char": char,
        "available_spells": available_spells,
        "known_spells": known_spells,
        "max_spells": max_spells,
        "is_prepared_caster": is_prepared_caster,
        "spells_limit_type": spells_limit_type,
        "error": None,
        "success": None,
        "info": None
    })


from pydantic import BaseModel
from typing import Dict


class RewardRequest(BaseModel):
    xp: int = 0
    coins: Dict[str, int] = {}
    target: str = 'all'  # 'all' или char_id (строка)
    reason: str = ''


@app.post("/master/room/{room_id}/reward")
async def master_reward(
        room_id: str,
        reward: RewardRequest,
        current_user: dict = Depends(require_master)
):
    """Выдача наград с гарантированной точностью"""
    rooms_data = load_rooms()
    room = next(
        (r for r in rooms_data['rooms']
         if r['id'] == room_id and r['master_id'] == current_user['username']),
        None
    )
    if not room:
        return {"status": "error", "error": "Комната не найдена"}

    current_players = room.get('current_players', [])
    print(f"\n🎁 ЗАПРОС НАГРАДЫ: target='{reward.target}' (тип: {type(reward.target)})")
    print(f"👥 Игроки в комнате: {current_players}")

    targets = []

    # Строгое сравнение со строкой 'all'
    if str(reward.target).strip().lower() == 'all':
        for p in current_players:
            targets.append({
                'username': p.get('username'),
                'char_id': p.get('char_id'),
                'char_name': p.get('char_name', 'Неизвестно')
            })
    else:
        try:
            target_char_id = int(reward.target)
            print(f"🎯 Ищем персонажа с char_id={target_char_id}")

            for p in current_players:
                # Строгое сравнение int с int
                if int(p.get('char_id', 0)) == target_char_id:
                    targets.append({
                        'username': p.get('username'),
                        'char_id': target_char_id,
                        'char_name': p.get('char_name', 'Неизвестно')
                    })
                    break  # 🔥 ВАЖНО: прерываем цикл сразу после нахождения!

        except (ValueError, TypeError):
            print(f"❌ Неверный char_id: {reward.target}")
            return {"status": "error", "error": "Неверный ID персонажа"}

    print(f"✅ ИТОГОВЫЕ ЦЕЛИ ({len(targets)}): {targets}")

    if not targets:
        return {"status": "error", "error": "Нет игроков для награды"}

    rewarded_count = 0
    for t in targets:
        username = t['username']
        char_id = t['char_id']
        char_name = t['char_name']

        print(f"\n📝 Обработка: {char_name} (user={username}, char_id={char_id})")

        chars_path = settings.DATA_DIR / "user_data" / f"{username}_chars.json"
        if not chars_path.exists():
            continue

        with open(chars_path, 'r', encoding='utf-8') as f:
            user_chars = json.load(f)

        char = next((c for c in user_chars if c.get('id') == char_id), None)
        if not char:
            continue

        # Начисление XP
        if reward.xp > 0:
            old_xp = char.get('xp', 0)
            old_level = char.get('level', 1)
            char['xp'] = old_xp + reward.xp
            new_level = calc_level_from_xp(char['xp'])
            char['level'] = new_level
            char.setdefault('attributes', {})
            char['attributes']['prof_bonus'] = f"+{calc_prof_bonus(new_level)}"
            print(f"   ✨ XP: {old_xp} → {char['xp']} (+{reward.xp})")

        # Начисление монет
        if reward.coins:
            char.setdefault('inventory', {})
            char['inventory'].setdefault('coins', {'cp': 0, 'sp': 0, 'ep': 0, 'gp': 0, 'pp': 0})
            for coin_type, amount in reward.coins.items():
                if amount and amount > 0 and coin_type in char['inventory']['coins']:
                    char['inventory']['coins'][coin_type] += amount

        with open(chars_path, 'w', encoding='utf-8') as f:
            json.dump(user_chars, f, indent=4, ensure_ascii=False)
        rewarded_count += 1

    # Запись в историю
    if rewarded_count > 0:
        room.setdefault('roll_history', []).append({
            'type': 'reward',
            'master': current_user['username'],
            'targets': [t['char_name'] for t in targets],
            'xp': reward.xp,
            'coins': reward.coins,
            'reason': reward.reason,
            'timestamp': time.time()
        })
        save_rooms(rooms_data)

    return {
        "status": "ok",
        "message": f"Награда выдана {rewarded_count} игрокам",
        "rewarded_count": rewarded_count
    }


def cleanup_stale_players(room_id: str, timeout_seconds: int = 300):
    """Удаляет игроков, не подававших пульс более timeout_seconds"""
    rooms_data = load_rooms()
    room = next((r for r in rooms_data['rooms'] if r['id'] == room_id), None)
    if not room:
        return

    now = time.time()
    original_count = len(room.get('current_players', []))

    # Оставляем только тех, кто был активен недавно
    room['current_players'] = [
        p for p in room.get('current_players', [])
        if (now - p.get('last_active', now)) < timeout_seconds
    ]

    if len(room['current_players']) < original_count:
        save_rooms(rooms_data)
        print(f"🧹 Очищено {original_count - len(room['current_players'])} неактивных игроков из комнаты {room_id}")

@app.post("/char/{char_id}/spells/learn")
async def learn_spell(
        char_id: int,
        spell_name: str = Form(...),
        current_user: dict = Depends(require_player)
):
    chars = load_chars(current_user['username'])
    char = next((c for c in chars if c['id'] == char_id), None)
    if not char:
        return RedirectResponse(url="/chars", status_code=303)

    char = normalize_char(char)
    char.setdefault('inventory', {}).setdefault('known_spells', [])

    if spell_name not in char['inventory']['known_spells']:
        char['inventory']['known_spells'].append(spell_name)
        save_chars(current_user['username'], chars)
        # TODO: flash message через cookie

    return RedirectResponse(url=f"/char/{char_id}/spells", status_code=303)


@app.post("/char/{char_id}/spells/forget")
async def forget_spell(
        char_id: int,
        spell_name: str = Form(...),
        current_user: dict = Depends(require_player)
):
    chars = load_chars(current_user['username'])
    char = next((c for c in chars if c['id'] == char_id), None)
    if not char:
        return RedirectResponse(url="/chars", status_code=303)

    char = normalize_char(char)
    if 'inventory' in char and 'known_spells' in char['inventory']:
        if spell_name in char['inventory']['known_spells']:
            char['inventory']['known_spells'].remove(spell_name)
            save_chars(current_user['username'], chars)

    return RedirectResponse(url=f"/char/{char_id}/spells", status_code=303)


