@app.post("/master/room/create")
async def create_room(
        request: Request,
        name: str = Form(...),
        description: Optional[str] = Form(""),
        max_players: int = Form(6),
        current_user: dict = Depends(require_master)
):
    name = name.strip()
    if not name:
        return templates.TemplateResponse("master_dashboard.html", {
            "request": request,
            "error": "Название комнаты обязательно",
            "rooms": [r for r in load_rooms()['rooms'] if r.get('master_id') == current_user['username']]
        })

    rooms_data = load_rooms()
    new_room = {
        'id': f"room_{generate_invite_code()}_{int(time.time())}",
        'master_id': current_user['username'],
        'name': name,
        'description': description.strip(),
        'invite_code': generate_invite_code(),
        'max_players': max(1, min(max_players, 10)),
        'current_players': [],
        'created_at': datetime.now().strftime('%Y-%m-%d %H:%M'),
        'active': True
    }
    rooms_data['rooms'].append(new_room)
    save_rooms(rooms_data)

    response = RedirectResponse(url="/master", status_code=303)
    response.set_cookie("flash", f"success:✅ Комната создана! Код: {new_room['invite_code']}")
    return response


@app.post("/master/room/delete/{room_id}")
async def delete_room(
        room_id: str,
        request: Request,
        current_user: dict = Depends(require_master)
):
    rooms_data = load_rooms()
    rooms_data['rooms'] = [
        r for r in rooms_data['rooms']
        if not (r['id'] == room_id and r['master_id'] == current_user['username'])
    ]
    save_rooms(rooms_data)
    return RedirectResponse(url="/master", status_code=303)


@app.get("/master/room/{room_id}", response_class=HTMLResponse)
async def master_room(
    room_id: str,
    request: Request,
    current_user: dict = Depends(require_master)
):
    rooms_data = load_rooms()
    room = next(
        (r for r in rooms_data['rooms']
         if r['id'] == room_id and r['master_id'] == current_user['username']),
        None
    )
    if not room:
        return RedirectResponse(url="/master", status_code=303)

    cleanup_stale_players(room_id, timeout_seconds=300)

    players_data = []
    for p in room.get('current_players', []):
        username = p.get('username')
        char_id = p.get('char_id')
        if username and char_id:
            user_chars = load_chars(username)
            char = next((c for c in user_chars if c['id'] == char_id), None)
            if char:
                char = normalize_char(char)
                lvl = char.get('level', 1)
                xp_prog = get_level_progress(char.get('xp', 0), lvl)
                next_xp = XP_THRESHOLDS[lvl] if lvl < 20 else "MAX"
                players_data.append({
                    'username': username,
                    'char': char,
                    'xp_progress': xp_prog,
                    'next_level_xp': next_xp
                })

    return templates.TemplateResponse("master_room.html", context={
        "request": request,
        "room": room,
        "players": players_data,
        "username": current_user['username'],
        "error": None,
        "success": None
    })


@app.get("/master/room/{room_id}/events")
async def master_room_events(
        room_id: str,
        request: Request,
        current_user: dict = Depends(require_master)
):
    """SSE endpoint для мастера"""
    rooms_data = load_rooms()
    room = next(
        (r for r in rooms_data['rooms']
         if r['id'] == room_id and r['master_id'] == current_user['username']),
        None
    )
    if not room:
        return StreamingResponse(iter([]), status_code=404)

    queue = add_sse_listener(room_id)

    async def event_stream():
        try:
            while True:
                if queue:
                    event = queue.pop(0)
                    yield f"event: {event['event']}\ndata: {json.dumps(event['data'], ensure_ascii=False)}\n\n"
                else:
                    await asyncio.sleep(0.5)
        finally:
            remove_sse_listener(room_id, queue)

    return StreamingResponse(
        event_stream(),
        media_type="text/event-stream",
        headers={
            "Cache-Control": "no-cache",
            "Connection": "keep-alive",
            "X-Accel-Buffering": "no"  # Для nginx
        }
    )


from pydantic import BaseModel
from typing import Optional, Dict








@app.get("/master/room/{room_id}/char/{char_id}", response_class=HTMLResponse)
async def master_char_view(
        room_id: str,
        char_id: int,
        request: Request,
        current_user: dict = Depends(require_master)
):
    """Просмотр листа персонажа игрока из комнаты мастера"""
    # Проверяем, что комната принадлежит мастеру
    rooms_data = load_rooms()
    room = next(
        (r for r in rooms_data['rooms']
         if r['id'] == room_id and r['master_id'] == current_user['username']),
        None
    )
    if not room:
        return RedirectResponse(url="/master", status_code=303)

    # Ищем игрока в комнате
    player_entry = next(
        (p for p in room.get('current_players', [])
         if p.get('char_id') == char_id),
        None
    )
    if not player_entry:
        return RedirectResponse(url=f"/master/room/{room_id}", status_code=303)

    # Загружаем персонажа
    user_chars = load_chars(player_entry['username'])
    char = next((c for c in user_chars if c['id'] == char_id), None)
    if not char:
        return RedirectResponse(url=f"/master/room/{room_id}", status_code=303)

    char = normalize_char(char)
    char['_calculated_ac'] = calculate_ac(char)

    # Подготавливаем данные
    saves, skills = prepare_skills_and_saves(char)
    features = get_class_features(
        char.get('char_class', ''),
        char.get('subclass', 'Нет'),
        char.get('level', 1)
    )

    # Прогресс опыта
    current_level = char.get('level', 1)
    current_xp = char.get('xp', 0)
    xp_progress = get_level_progress(current_xp, current_level)
    next_level_xp = XP_THRESHOLDS[current_level] if current_level < 20 else "MAX"

    return templates.TemplateResponse("character_view.html", context={
        "request": request,
        "char": char,
        "saves": saves,
        "skills": skills,
        "class_features": features,
        "back_url": f"/master/room/{room_id}",
        "back_text": "← Назад в комнату",
        "current_user": current_user,
        "xp_progress": xp_progress,
        "next_level_xp": next_level_xp,
        "error": None,
        "success": None
    })

