@app.post("/new_char")
async def create_character(request: Request, current_user: dict = Depends(require_player)):
    # 🔹 Получаем все данные формы как словарь (без строгой валидации)
    form = await request.form()

    try:
        # === Извлечение данных с безопасными дефолтами ===
        name = form.get('name', '').strip()
        race = form.get('race', '')
        char_class = form.get('char_class', '')
        subclass = form.get('subclass', 'Нет')
        alignment = form.get('alignment', 'Истинно нейтральный')

        # Опыт и уровень
        xp = int(form.get('xp', 0) or 0)
        level = calc_level_from_xp(xp)

        # Внешность
        physical = {
            'height': form.get('height', ''),
            'weight': form.get('weight', ''),
            'hair': form.get('hair', ''),
            'eyes': form.get('eyes', '')
        }

        # Характеристики (с валидацией диапазона)
        stats = {}
        for stat_key in ["STR", "DEX", "CON", "INT", "WIS", "CHA"]:
            try:
                score = int(form.get(stat_key, 10) or 10)
                score = max(1, min(30, score))  # Ограничиваем 1-30
            except (ValueError, TypeError):
                score = 10
            stats[stat_key] = {
                'score': score,
                'modifier': calc_modifier(score)
            }

        # Навыки и спасброски (списки из чекбоксов)
        saving_throws = form.getlist('saving_throws')  # ✅ getlist для множественных значений
        skills = form.getlist('skills')

        # Боевые параметры
        ac = form.get('ac', '10')
        speed = form.get('speed', '30 фт')

        # Инициатива от Ловкости
        dex_mod = stats['DEX']['modifier']
        initiative = f"+{dex_mod}" if dex_mod >= 0 else str(dex_mod)

        # ХП
        hp_current = int(form.get('hp_current', 10) or 10)
        hp_max = int(form.get('hp_max', 10) or 10)
        hp_temp = int(form.get('hp_temp', 0) or 0)

        # === Валидация обязательных полей ===
        if not name:
            return _render_char_form_error(request, "Имя персонажа обязательно")
        if not race:
            return _render_char_form_error(request, "Выберите расу")
        if not char_class:
            return _render_char_form_error(request, "Выберите класс")

        # === Создание персонажа ===
        chars = load_chars(current_user['username'])
        new_id = max([c['id'] for c in chars], default=0) + 1

        new_char = {
            'id': new_id,
            'name': name,
            'race': race,
            'char_class': char_class,
            'subclass': subclass,
            'alignment': alignment,
            'level': level,
            'xp': xp,
            'physical': physical,
            'stats': stats,
            'saving_throws': saving_throws,
            'skills': skills,
            'attributes': {
                'ac': ac,
                'initiative': initiative,
                'speed': speed,
                'prof_bonus': '+2'  # Уровень 1
            },
            'hp': {
                'current': hp_current,
                'max': hp_max,
                'temp': hp_temp
            },
            'description': '',
            'inventory': {
                'weapons': [], 'armor': [], 'gear': [],
                'arrows': [], 'bolts': [],
                'coins': {'cp': 0, 'sp': 0, 'ep': 0, 'gp': 0, 'pp': 0},
                'known_spells': []
            },
            'features_spells': ''
        }

        chars.append(new_char)
        save_chars(current_user['username'], chars)

        # ✅ Успех → редирект
        return RedirectResponse(url="/chars", status_code=303)

    except Exception as e:
        # ❌ Ошибка → возврат на форму с сообщением
        import traceback
        print(f"⚠️ Ошибка создания персонажа: {e}")
        traceback.print_exc()
        return _render_char_form_error(request, f"Ошибка: {str(e)}", form_data=form)


# Глобальное хранилище — теперь с информацией о клиентах
active_rooms: Dict[str, Dict] = {}


def get_room_ws_data(room_id: str) -> dict:
    if room_id not in active_rooms:
        active_rooms[room_id] = {
            'clients': {},  # {websocket: {'username': ..., 'char_name': ...}}
            'map_image': None,
            'map_width': 0,
            'map_height': 0,
        }
    return active_rooms[room_id]


async def broadcast_to_room(room_id: str, message: dict, exclude: WebSocket = None):
    room = get_room_ws_data(room_id)
    dead = []
    for ws in room['clients']:
        if ws == exclude:
            continue
        try:
            await ws.send_json(message)
        except Exception:
            dead.append(ws)
    for ws in dead:
        del room['clients'][ws]


@app.websocket("/ws/room/{room_id}")
async def room_websocket(websocket: WebSocket, room_id: str):
    await websocket.accept()

    # === Проверка комнаты ===
    rooms_data = load_rooms()
    room_data = next((r for r in rooms_data['rooms'] if r['id'] == room_id), None)
    if not room_data:
        await websocket.close(code=4004, reason="Room not found")
        return

    # === Ждём auth-сообщение от клиента ===
    try:
        auth = await asyncio.wait_for(websocket.receive_json(), timeout=5.0)
    except Exception:
        await websocket.close(code=4001, reason="No auth")
        return

    username = auth.get('username', 'unknown')
    char_name = auth.get('char_name', username)
    is_master = room_data.get('master_id') == username

    room = get_room_ws_data(room_id)
    room['clients'][websocket] = {
        'username': username,
        'char_name': char_name,
        'is_master': is_master
    }

    # === Отправляем клиенту init ===
    await websocket.send_json({
        'type': 'init',
        'is_master': is_master,
        'username': username,
        'char_name': char_name
    })

    # === Если есть карта — отправляем её ===
    if room.get('map_image'):
        await websocket.send_json({
            'type': 'map_update',
            'image': room['map_image'],
            'width': room.get('map_width', 0),
            'height': room.get('map_height', 0),
            'is_master': is_master
        })

    # === Если есть токены — отправляем их ===
    if room.get('tokens'):
        await websocket.send_json({
            'type': 'tokens_init',
            'tokens': list(room['tokens'].values())
        })

    # === Уведомляем всех о подключении ===
    await broadcast_to_room(room_id, {
        'type': 'player_join',
        'username': username,
        'char_name': char_name,
        'is_master': is_master
    })

    print(f"🔌 [{room_id}] {username} ({char_name}) подключился (мастер={is_master})")

    # === ГЛАВНЫЙ ЦИКЛ обработки сообщений ===
    try:
        while True:
            data = await websocket.receive_json()
            msg_type = data.get('type')
            client = room['clients'].get(websocket)
            if not client:
                continue

            # --- Бросок кубика ---
            if msg_type == 'dice_roll':
                message = {
                    'type': 'dice_roll',
                    'username': client['username'],
                    'char_name': client['char_name'],
                    'is_master': client['is_master'],
                    'name': data.get('name', ''),
                    'roll': data.get('roll'),
                    'sides': data.get('sides'),
                    'modifier': data.get('modifier', 0),
                    'total': data.get('total'),
                    'is_crit': data.get('is_crit', False),
                    'is_fail': data.get('is_fail', False),
                    'timestamp': time.time()
                }
                await broadcast_to_room(room_id, message)

            # --- Загрузка карты (только мастер) ---
            elif msg_type == 'map_update' and is_master:
                room['map_image'] = data.get('image')
                room['map_width'] = data.get('width', 0)
                room['map_height'] = data.get('height', 0)
                await broadcast_to_room(room_id, {
                    'type': 'map_update',
                    'image': data.get('image'),
                    'width': data.get('width', 0),
                    'height': data.get('height', 0),
                    'username': username,
                    'char_name': char_name
                })

            # --- Очистка карты (только мастер) ---
            elif msg_type == 'map_clear' and is_master:
                room['map_image'] = None
                room['map_width'] = 0
                room['map_height'] = 0
                await broadcast_to_room(room_id, {
                    'type': 'map_clear',
                    'username': username,
                    'char_name': char_name
                })

            # --- Управление токенами ---
            elif msg_type == 'token_update':
                action = data.get('action')
                token_data = data.get('token', {})
                char_id = token_data.get('char_id')

                if not char_id:
                    continue

                char_id_str = str(char_id)

                if action == 'add':
                    room.setdefault('tokens', {})[char_id_str] = token_data
                    await broadcast_to_room(room_id, {
                        'type': 'token_add',
                        'token': token_data
                    })

                elif action == 'remove':
                    if char_id_str in room.get('tokens', {}):
                        del room['tokens'][char_id_str]
                    await broadcast_to_room(room_id, {
                        'type': 'token_remove',
                        'char_id': char_id
                    })

                elif action == 'move':
                    if char_id_str in room.get('tokens', {}):
                        room['tokens'][char_id_str]['x'] = token_data.get('x')
                        room['tokens'][char_id_str]['y'] = token_data.get('y')
                        await broadcast_to_room(room_id, {
                            'type': 'token_move',
                            'token': token_data
                        })

    except WebSocketDisconnect:
        if websocket in room['clients']:
            del room['clients'][websocket]
        print(f"🔌 [{room_id}] {username} отключился")
        await broadcast_to_room(room_id, {
            'type': 'player_leave',
            'username': username,
            'char_name': char_name
        })
    except Exception as e:
        print(f"❌ WebSocket error [{room_id}]: {e}")
        if websocket in room['clients']:
            del room['clients'][websocket]


