# Глобальное хранилище активных комнат
active_rooms: Dict[str, Dict] = {}


def get_room_ws_data(room_id: str) -> dict:
    """Получает или создаёт данные WebSocket-комнаты"""
    if room_id not in active_rooms:
        active_rooms[room_id] = {
            'connections': set(),
            'map_image': None,
            'map_width': 0,
            'map_height': 0,
        }
    return active_rooms[room_id]


async def broadcast_to_room(room_id: str, message: dict, exclude: WebSocket = None):
    """Отправляет сообщение всем подключённым в комнате"""
    room = get_room_ws_data(room_id)
    dead_connections = set()

    for ws in room['connections']:
        if ws == exclude:
            continue
        try:
            await ws.send_json(message)
        except Exception:
            dead_connections.add(ws)

    # Удаляем мёртвые соединения
    room['connections'] -= dead_connections


