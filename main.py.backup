# Custom filter for templates
# После создания templates:
def nl2br_filter(s: str):
    """Заменяет переносы строк на <br>"""
    from markupsafe import Markup
    return Markup(s.replace('\n', '<br>\n')) if s else ''

templates.env.filters['nl2br'] = nl2br_filter

# === Фильтры Jinja2 ===
from datetime import datetime

def timestamp_to_date(ts):
    """Преобразует Unix-timestamp в читаемую дату"""
    try:
        return datetime.fromtimestamp(int(ts)).strftime('%d.%m.%Y %H:%M')
    except (ValueError, TypeError, OSError):
        return '—'

templates.env.filters['timestamp_to_date'] = timestamp_to_date

from pydantic import BaseModel


class TokenUpload(BaseModel):
    image: str  # base64 data URL


@app.post("/char/{char_id}/token/upload")
async def upload_token(
        char_id: int,
        token_data: TokenUpload,
        current_user: dict = Depends(require_player)
):
    """Загрузка токена персонажа"""
    chars = load_chars(current_user['username'])
    char = next((c for c in chars if c['id'] == char_id), None)
    if not char:
        return {"status": "error", "error": "Персонаж не найден"}

    # Проверяем размер (base64 ~1.37x от оригинала)
    if len(token_data.image) > 3 * 1024 * 1024:  # ~2MB оригинала
        return {"status": "error", "error": "Изображение слишком большое"}

    char['token_image'] = token_data.image
    save_chars(current_user['username'], chars)

    return {"status": "ok", "message": "Токен загружен"}


@app.post("/char/{char_id}/token/remove")
async def remove_token(
        char_id: int,
        current_user: dict = Depends(require_player)
):
    """Удаление токена персонажа"""
    chars = load_chars(current_user['username'])
    char = next((c for c in chars if c['id'] == char_id), None)
    if not char:
        return RedirectResponse(url="/chars", status_code=303)

    char['token_image'] = None
    save_chars(current_user['username'], chars)

    return RedirectResponse(url=f"/char/{char_id}", status_code=303)

# === Middleware for sessions (cookie-based) ===
@app.middleware("http")
async def session_middleware(request: Request, call_next):
    response = await call_next(request)
    # Здесь можно добавить логику обновления cookie-сессии
    return response


# === Login page ===
@app.get("/login", response_class=HTMLResponse)
async def login_page(request: Request):
    session_cookie = request.cookies.get('session')
    if session_cookie:
        try:
            user = json.loads(session_cookie)
            if user.get('expires', 0) > time.time():
                return RedirectResponse(
                    url="/master" if user.get('role') == 'master' else "/chars",
                    status_code=303
                )
        except:
            pass
    # ✅ Используем context= keyword argument
    return templates.TemplateResponse("login.html", context={"request": request})


@app.post("/login")
async def login(
        request: Request,
        username: str = Form(...),
        password: str = Form(...),
        action: str = Form(...),
        role: str = Form("player")
):
    username = username.strip().lower()
    users = load_users()

    if action == 'register':
        if username in users:
            return templates.TemplateResponse("login.html", context={
                "request": request,
                "error": "Пользователь уже существует",
                "role": role  # Сохраняем выбор роли в форме
            })
        users[username] = {'password': generate_password_hash(password), 'role': role}
        save_users(users)
        return templates.TemplateResponse("login.html", context={
            "request": request,
            "success": "Аккаунт создан! Войдите в систему.",
            "role": role
        })
    else:
        if username not in users or not check_password_hash(users[username]['password'], password):
            return templates.TemplateResponse("login.html", context={
                "request": request,
                "error": "Неверный логин или пароль",
                "role": role
            })

        session = json.dumps({
            'username': username,
            'role': users[username]['role'],
            'expires': (datetime.now() + timedelta(days=1)).timestamp()
        })
        response = RedirectResponse(
            url="/chars" if users[username]['role'] == 'player' else "/master",
            status_code=303
        )
        response.set_cookie("session", session, httponly=True, max_age=86400, samesite="lax")
        return response

@app.get("/logout")
async def logout():
    response = RedirectResponse(url="/login", status_code=303)
    response.delete_cookie("session")
    return response


