# Обязательные секреты
SECRET_KEY=replace-with-a-random-string-at-least-32-characters
DB_PASSWORD=replace-with-a-strong-password
S3_SECRET_KEY=replace-with-a-strong-password

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dnd
DB_USER=dndapp

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# S3 / MinIO
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=admin
S3_BUCKET=folio-maps

# Приложение
APP_BASE_URL=http://localhost:8000
SESSION_COOKIE_SECURE=false
WS_ALLOWED_ORIGINS=
ADMIN_USERNAMES=your_username
MARKETPLACE_PURCHASES_ENABLED=false

# SMTP (необязательно в разработке)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Folio VTT
