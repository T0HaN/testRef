# ============================================================
# D&D Middle-earth — .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# --- Виртуальное окружение ---
.venv/
venv/
env/

# --- Секреты (Шаг 1 аудита безопасности) ---
.env
.env.*
!.env.example

# --- Артефакты разработки (бэкапы и мусор из репозитория) ---
*.backup
*.bak
*.orig
test.html
*.log

# --- IDE / ОС ---
.vscode/
.idea/
.DS_Store
Thumbs.db